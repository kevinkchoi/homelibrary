# ==== PostgreSQL ====
POSTGRES_USER=homelibrary
POSTGRES_PASSWORD=change_me
POSTGRES_DB=homelibrary
# 백엔드가 접속에 사용하는 URL (컨테이너 내부 네트워크 기준, 보통 수정할 필요 없음)
DATABASE_URL=postgresql+psycopg2://homelibrary:change_me@homelibrary-db:5432/homelibrary

# ==== 인증 ====
# openssl rand -hex 32 등으로 생성한 임의의 긴 문자열을 넣으세요.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440

# ==== 책 사진 스캔 (Claude Vision) ====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# ==== 알라딘 Open API (국내도서 검색/표지) ====
# https://www.aladin.co.kr/ttb/wblog_manage.aspx 에서 TTBKey 발급 (무료)
ALADIN_TTB_KEY=

# ==== Google Books API (해외도서 폴백, 선택사항) ====
# 없어도 동작하지만, 있으면 요청 한도가 늘어남
GOOGLE_BOOKS_API_KEY=

# ==== 카카오(다음) 책 검색 REST API (국내도서 보강, 선택사항) ====
# https://developers.kakao.com 에서 무료 발급 (앱 > 앱 키 > REST API 키)
# (알라딘이 못 찾는 국내서를 찾아주는 보조 소스. 자세한 발급 방법은 docs/API_KEYS.md 4절)
# 참고: 네이버 책 검색 API는 2026-07-31 종료되어 더 이상 신규 발급 불가
KAKAO_REST_API_KEY=

# ==== Google 프로그래머블 검색 (웹 이미지, 해외 원서 표지용, 선택사항) ====
# 책 카탈로그에 표지가 없는 책(특히 해외 원서)을 웹 전체에서 찾는 최후의 소스.
# GOOGLE_CSE_ID(검색엔진 ID)는 필수. GOOGLE_CSE_API_KEY는 비우면 위 GOOGLE_BOOKS_API_KEY를 재사용.
# 발급 방법은 docs/API_KEYS.md 5절 (무료 100회/일)
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# ==== 웹 포트 ====
WEB_PORT=8080

# ==== 운영 형태 ====
# family  : 가족이 한 서재를 함께 쓴다. 공개 가입 없음(관리자가 [사용자 관리]에서 계정을 만든다). 기본값.
# personal: 사용자마다 자기 서재. 아래 초대 코드를 아는 사람만 가입. 공유 기능은 아직 없다.
LIBRARY_MODE=family
# personal 모드 가입 초대 코드. 비우면 가입이 닫힌다(첫 계정 = 운영자만 예외).
SIGNUP_INVITE_CODE=
# 사용자가 넣는 Claude API 키를 암호화할 비밀값(openssl rand -hex 32). 비우면 JWT_SECRET에서 파생.
# ⚠️ 바꾸면 이미 저장된 사용자 키를 못 읽는다(사용자가 다시 넣어야 함).
USER_KEY_SECRET=

# ==== 같은 서버에 두 번째 서비스를 띄울 때 (선택) ====
# 컨테이너 이름 앞머리. 비우면 homelibrary-db / -api / -web / -tunnel.
CONTAINER_PREFIX=
# Cloudflare 터널(docker-compose.tunnel.yml)용 — 비우면 첫 번째 서비스 값
TUNNEL_PROJECT=
TUNNEL_CREDENTIALS=
TUNNEL_CONFIG=
APP_NETWORK=
